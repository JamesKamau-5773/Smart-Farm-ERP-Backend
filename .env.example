# Copy to .env and fill in. Never commit .env.
# Under docker compose, DATABASE_URL, REDIS_URL, CELERY_* and CORS_ALLOWED_ORIGINS are set by
# docker-compose.yml and override the values here.

APP_ENV=development

# Secrets: at least 32 characters each in production.
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me
BOOTSTRAP_SUPER_ADMIN_KEY=

# Local (non-Docker) development
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DBNAME
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DBNAME_test
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Headers carrying the visitor's real IP from a trusted proxy (comma-separated).
# Leave unset: production defaults to True-Client-IP,CF-Connecting-IP (Render via
# Cloudflare); development uses the socket address. Never trust X-Forwarded-For here.
# CLIENT_IP_HEADERS=

# M-Pesa (Daraja)
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_BUSINESS_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=

# WhatsApp Cloud API (Meta)
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Public E.164 number users message with VERIFY-/RESET- codes (shown in wa.me links).
WHATSAPP_BUSINESS_NUMBER=

# Frontend origin used in reset/verification links and Google redirects.
FRONTEND_BASE_URL=http://localhost:5173

# Authentication
# HMAC key for one-time codes and tokens. At least 32 characters in production;
# rotating it invalidates all outstanding codes and links.
AUTH_CODE_PEPPER=change-me
AUTH_CHALLENGE_TTL_SECONDS=600
AUTH_CHALLENGE_MAX_ATTEMPTS=5
# Production with the frontend on a different site needs SameSite=None + Secure.
JWT_COOKIE_SAMESITE=Lax
JWT_COOKIE_SECURE=False

# Google sign-in (Google Cloud Console > OAuth client, type "Web application").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an authorised redirect URI, e.g. https://api.example.com/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# Transactional email via Resend (password reset / email verification).
RESEND_API_KEY=
EMAIL_FROM="Maziwa Smart <no-reply@example.com>"
# True sends email through Celery (default in production).
AUTH_EMAIL_ASYNC=False

# Development only (ignored in production): log outbound WhatsApp messages instead of sending.
WHATSAPP_DRY_RUN=False

# Calendar dates for farm records (IANA time zone name).
FARM_TIMEZONE=Africa/Nairobi
